# BhumiLens AI + BhumiGuard Environment Configuration
# LandTech Innovation Hackathon 2026

# Application
APP_ENV=development
DEBUG=True
SECRET_KEY=demo_dev_secret_key_change_in_production_32bytes_min_len_1234
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Databases
# MongoDB: authoritative for users, sessions, roles, app metadata
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=bhumilens_gov

# SQLite: authoritative for local immutable audit ledger and hash-chain
SQLITE_DB_PATH=outputs/bhumilens_gov_records.db

# Storage
STORAGE_CROPS_DIR=outputs/crops
STORAGE_PROCESSED_DIR=outputs/processed

# OCR Configuration
# Path to Tesseract binary if not on PATH (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe or /usr/bin/tesseract)
TESSERACT_CMD=
TESSERACT_LANGS=ben+eng

# SLM Configuration (Ollama or llama.cpp)
OLLAMA_BASE_URL=http://localhost:11434
SLM_MODEL_NAME=phi3:mini

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
